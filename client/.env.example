# Production Backend API URL:
# For Vercel/Netlify with reverse proxy rewrites: leave empty or set to /api
# For direct cross-origin Render backend connection:
# VITE_API_BASE_URL=https://life-rpg-server.onrender.com/api
VITE_API_BASE_URL=

# Local Development Proxy Target (optional, defaults to http://localhost:5000):
VITE_BACKEND_URL=http://localhost:5000
