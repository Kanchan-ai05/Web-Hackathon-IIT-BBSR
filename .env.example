# -------------------------------------------------------------
# CIT Campus Scheduling Platform - Environment Variables
# -------------------------------------------------------------

# Backend Settings
DATABASE_URL=sqlite:///./cit_schedule.db
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:3000,https://cit-scheduling.vercel.app

# Optional AI / LLM Configuration (For Natural Language Booking Parser)
# The application runs 100% offline without these keys!
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# Frontend Settings (frontend/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:8000
